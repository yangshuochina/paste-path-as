{
  "name": "paste-path-as",
  "displayName": "Paste Path As",
  "description": "Paste clipboard text as original Windows paths, escaped backslashes, or forward slashes.",
  "version": "1.0.0",
  "publisher": "yangshuochina",
  "keywords": ["path", "paste", "clipboard", "windows", "backslash"],
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "extensionKind": ["ui"],
  "capabilities": { "untrustedWorkspaces": { "supported": true }, "virtualWorkspaces": true },
  "contributes": {
    "commands": [{ "command": "pastePathAs.paste", "title": "Paste Path As...", "enablement": "editorTextFocus && !editorReadonly" }],
    "keybindings": [{ "command": "pastePathAs.paste", "key": "ctrl+alt+v", "mac": "cmd+alt+v", "when": "editorTextFocus && !editorReadonly" }],
    "menus": { "editor/context": [{ "command": "pastePathAs.paste", "when": "!editorReadonly", "group": "9_cutcopypaste@4" }] }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository"
  }
}
